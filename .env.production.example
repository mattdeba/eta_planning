NODE_ENV=production
APP_NAME=my_eta_planning_backend
APP_PORT=3000
API_PREFIX=api

DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=eta
DATABASE_PASSWORD=replace-with-a-strong-password
DATABASE_NAME=eta_planning
DATABASE_SSL=false
TYPEORM_LOGGING=false

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=12

SEED_ADMIN_EMAIL=admin@eta.local
SEED_ADMIN_PASSWORD=replace-with-a-strong-admin-password
